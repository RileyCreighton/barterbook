# Server ONLY: copy to .dev.vars for wrangler. No VITE_ provider keys.
APP_ORIGIN=http://localhost:5173
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_LOCALLY
SOLANA_RPC_FALLBACK_URL=https://api.devnet.solana.com
# Set true only after devnet fixture registry and live compatibility gates pass.
SETTLEMENT_ENABLED=false
# JSON array of three validated devnet mint entries (see setup documentation).
DEVNET_ASSETS_JSON=[]
# History capability is an operator-verified property, not inferred from a null status.
RPC_HISTORY_TRUSTED=false
FALLBACK_HISTORY_TRUSTED=false
# Public metadata; never put private keys in these values.
DEMO_PARTICIPANTS_JSON=[]
SITE_URL=
REPOSITORY_URL=
BUILD_ID=

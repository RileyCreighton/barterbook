{
  "name": "barterbook",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Fee-aware atomic baskets and three-owner exact-lot exchange on Solana Devnet",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build && node .github/scripts/prepare-legal.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply barterbook-devnet --local",
    "deploy": "npm run build && wrangler deploy",
    "spike": "node --import tsx scripts/signing-spike.ts",
    "profile": "node --import tsx scripts/profile.ts",
    "format": "prettier --write src tests scripts package.json tsconfig.json vite.config.ts vitest.config.ts wrangler.jsonc",
    "test:local-chain": "vitest run tests/local-runtime.test.ts",
    "smoke": "node --import tsx scripts/local-smoke.ts",
    "devnet:fixtures": "node --import tsx scripts/devnet-fixtures.ts",
    "devnet:exchange": "node --import tsx scripts/devnet-exchange.ts",
    "release:scan": "node scripts/secret-scan.mjs",
    "devnet:faucet": "node --import tsx scripts/devnet-faucet.ts",
    "devnet:seed": "node --import tsx scripts/devnet-board-seed.ts",
    "profile:hosted": "node scripts/hosted-cpu.mjs",
    "smoke:http": "node --import tsx scripts/http-smoke.ts"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/app": "1.1.0",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "hono": "4.13.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260925.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.4",
    "litesvm": "0.8.0",
    "prettier": "3.9.9",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.139.0"
  }
}
